# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Env files (the *.env.example files are committed)
.env
.env.*
!.env.example
!.env.production.example

# Test artefacts
coverage/
playwright-report/
test-results/
blob-report/

# Runtime data
apps/api/data/

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json

# Hidden tests (~93 MB) are regenerated deterministically: python scripts/gen-tests.py --all
# Samples 01-02 stay committed; seed/problems/CHECKSUMS.sha256 pins every generated file.
seed/problems/*/tests/*
!seed/problems/*/tests/01.*
!seed/problems/*/tests/02.*

# Throwaway probe tests written by review agents (deleted before each review commit)
__review__/
