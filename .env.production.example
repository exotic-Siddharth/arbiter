# Arbiter production settings: the values docker-compose.prod.yml reads.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production        # it will hold secrets; it is git-ignored
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Blank values are REQUIRED: compose refuses to start until they are filled in. There are no secrets in
# this file. Step-by-step: docs/DEPLOYMENT.md.
#
# The API refuses to start in production with the published development JWT secret or the
# development admin password, or with rate limiting off (apps/api/src/config/env.ts, review A-09).

# ---- required ----
# The https:// address people open in the browser: no path, no trailing slash. It is the CORS and
# cookie origin. The placeholder below is a reserved example domain: replace it.
PUBLIC_ORIGIN=https://judge.example.com
# URL-safe characters only (it is embedded in DATABASE_URL), e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs access tokens (HS256), at least 32 characters, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Numeric group id that owns the host's Docker socket, so the non-root worker can use it:
#   stat -c %g /var/run/docker.sock
DOCKER_GID=

# ---- judge ----
# The sandbox image, built on the host first: docker build -t arbiter-sandbox:latest sandbox
SANDBOX_IMAGE=arbiter-sandbox:latest
# Optional OCI runtime for the sandbox containers, e.g. runsc (gVisor). Empty = Docker's default.
SANDBOX_RUNTIME=
# Sandbox containers run in parallel per worker (judge jobs and custom-input runs). Size to the VM: a
# container is capped at the problem's memory limit plus runtime overhead (at most 2 GB), and 1 CPU.
JUDGE_CONCURRENCY=2
RUN_CONCURRENCY=1

# ---- optional ----
# The address the web container publishes on the host. Loopback by default: put TLS in front of it.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# The "Try the demo" login. DEMO_LOGIN_ENABLED enables POST /api/auth/demo on the server (it also needs
# a user named demo); VITE_DEMO_LOGIN shows the button and is compiled into the bundle at build time.
DEMO_LOGIN_ENABLED=false
VITE_DEMO_LOGIN=false
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Tag of the images built here (arbiter-api, arbiter-web).
ARBITER_TAG=latest
# Host name for the optional Caddy TLS front (docker compose ... --profile tls).
DOMAIN=judge.example.com
