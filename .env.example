# Arbiter: every configuration variable (spec section 6 plus the build resolutions).
#
# Local development reads two files:
#   apps/api/.env  (API, worker, Prisma CLI, seed)  -> copy apps/api/.env.example
#   apps/web/.env  (Vite dev server and SPA)        -> copy apps/web/.env.example
# This root file documents the full set in one place (e.g. for docker-compose.prod.yml).
# Values below are LOCAL DEV VALUES ONLY.

# ---- API + worker ----
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://arbiter:arbiter@localhost:55432/arbiter?schema=public
REDIS_URL=redis://localhost:56379/0
QUEUE_PREFIX=arbiter
SOCKET_IO_KEY=
RATE_LIMITS_ENABLED=true
RATE_LIMIT_PREFIX=arb:rl
TRUST_PROXY=0
JWT_ACCESS_SECRET=dev-only-insecure-access-secret-change-me-0000
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
DEMO_LOGIN_ENABLED=true
SANDBOX_IMAGE=arbiter-sandbox:latest
SANDBOX_RUNTIME=
DOCKER_BIN=docker
JUDGE_CONCURRENCY=2
RUN_CONCURRENCY=1
WORKER_METRICS_PORT=9464
SEED_ADMIN_PASSWORD=admin12345
SEED_DEMO_PASSWORD=demo12345
LOG_LEVEL=info

# ---- Web ----
VITE_DEMO_LOGIN=true
API_PROXY_TARGET=http://localhost:4000
WEB_PORT=5173
