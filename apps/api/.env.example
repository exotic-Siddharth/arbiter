# Arbiter API + worker configuration. Copy to apps/api/.env for local development.
# Every variable is validated at startup by src/config/env.ts (zod); invalid values abort the process.
# The Prisma CLI also reads this file (run Prisma commands from apps/api, e.g. `npm run db:migrate`).
# Real environment variables always win over values in this file.

NODE_ENV=development
API_PORT=4000
# CORS origin and cookie origin of the SPA.
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://arbiter:arbiter@localhost:55432/arbiter?schema=public
REDIS_URL=redis://localhost:56379/0

# BullMQ queue prefix. Tests use a random one per test file.
QUEUE_PREFIX=arbiter
# Socket.IO redis adapter/emitter channel key. Empty = "<QUEUE_PREFIX>-sio".
SOCKET_IO_KEY=

# Rate limits (Redis store). RATE_LIMITS_ENABLED=false is refused when NODE_ENV=production.
RATE_LIMITS_ENABLED=true
RATE_LIMIT_PREFIX=arb:rl
# Express "trust proxy" hop count: 0 in dev, 1 behind the production nginx.
TRUST_PROXY=0

# Access-token signing secret (HS256, at least 32 chars). LOCAL DEV VALUE ONLY: set a random secret in production.
JWT_ACCESS_SECRET=dev-only-insecure-access-secret-change-me-0000
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
# POST /api/auth/demo. Default: true when NODE_ENV=development, false otherwise.
DEMO_LOGIN_ENABLED=true

# Judge sandbox.
SANDBOX_IMAGE=arbiter-sandbox:latest
# Optional container runtime, e.g. runsc for gVisor. Empty = Docker default.
SANDBOX_RUNTIME=
# Docker CLI. An absolute path is allowed, e.g. C:/Program Files/Docker/Docker/resources/bin/docker.exe
DOCKER_BIN=docker
JUDGE_CONCURRENCY=2
RUN_CONCURRENCY=1
# Port of the worker's own /metrics endpoint (0 = random free port).
WORKER_METRICS_PORT=9464

# Seed passwords (LOCAL DEV VALUES ONLY). SEED_ADMIN_PASSWORD is required when seeding with NODE_ENV=production.
SEED_ADMIN_PASSWORD=admin12345
SEED_DEMO_PASSWORD=demo12345

# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Test-only knobs (read by apps/api/test/*, never by the app):
#   TEST_SCHEMA        Postgres schema inside database arbiter_test (default: test; lanes use lane_<id>)
#   TEST_DATABASE_URL  base URL of the test database (default: postgresql://arbiter:arbiter@localhost:55432/arbiter_test)
#   TEST_REDIS_URL     Redis URL for tests (default: redis://localhost:56379/15)
#   TEST_LOG_LEVEL     pino level during tests (default: silent)
