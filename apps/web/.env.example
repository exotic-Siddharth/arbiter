# Arbiter web (Vite) configuration. Copy to apps/web/.env for local development.
# Only VITE_* variables are exposed to browser code (import.meta.env).

# Show the "Try the demo" button (calls POST /api/auth/demo).
VITE_DEMO_LOGIN=true

# Read by vite.config.ts only (never shipped to the browser):
# where the dev server proxies /api and /socket.io (ws), and the dev server port.
API_PROXY_TARGET=http://localhost:4000
WEB_PORT=5173
